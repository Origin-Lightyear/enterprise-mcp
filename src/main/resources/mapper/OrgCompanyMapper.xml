<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.OrgCompanyMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="OrgCompanyResultMap" type="com.kevin.mcp.entity.OrgCompany">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="legal_person" property="legalPerson"/>
        <result column="tax_number" property="taxNumber"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        code,
        name,
        legal_person,
        tax_number,
        status,
        created_at
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="OrgCompanyResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM org_company
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="OrgCompanyResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM org_company
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="code != null and code != ''">
                AND code = #{code}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="legalPerson != null and legalPerson != ''">
                AND legal_person = #{legalPerson}
            </if>
            <if test="taxNumber != null and taxNumber != ''">
                AND tax_number = #{taxNumber}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM org_company
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="code != null and code != ''">
                AND code = #{code}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="legalPerson != null and legalPerson != ''">
                AND legal_person = #{legalPerson}
            </if>
            <if test="taxNumber != null and taxNumber != ''">
                AND tax_number = #{taxNumber}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.OrgCompany" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO org_company
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">
                code,
            </if>
            <if test="name != null and name != ''">
                name,
            </if>
            <if test="legalPerson != null and legalPerson != ''">
                legal_person,
            </if>
            <if test="taxNumber != null and taxNumber != ''">
                tax_number,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="createdAt != null">
                created_at,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">
                #{code},
            </if>
            <if test="name != null and name != ''">
                #{name},
            </if>
            <if test="legalPerson != null and legalPerson != ''">
                #{legalPerson},
            </if>
            <if test="taxNumber != null and taxNumber != ''">
                #{taxNumber},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="createdAt != null">
                #{createdAt},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.OrgCompany">
        UPDATE org_company
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">
                code = #{code},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="legalPerson != null and legalPerson != ''">
                legal_person = #{legalPerson},
            </if>
            <if test="taxNumber != null and taxNumber != ''">
                tax_number = #{taxNumber},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="createdAt != null">
                created_at = #{createdAt},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM org_company
        WHERE id = #{id}
    </delete>
</mapper>
