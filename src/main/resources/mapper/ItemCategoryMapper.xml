<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.ItemCategoryMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="ItemCategoryResultMap" type="com.kevin.mcp.entity.ItemCategory">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="level" property="level"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        parent_id,
        name,
        sort_order,
        level
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="ItemCategoryResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM item_category
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="ItemCategoryResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM item_category
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="parentId != null">
                AND parent_id = #{parentId}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="sortOrder != null">
                AND sort_order = #{sortOrder}
            </if>
            <if test="level != null">
                AND level = #{level}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM item_category
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="parentId != null">
                AND parent_id = #{parentId}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="sortOrder != null">
                AND sort_order = #{sortOrder}
            </if>
            <if test="level != null">
                AND level = #{level}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.ItemCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO item_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">
                parent_id,
            </if>
            <if test="name != null and name != ''">
                name,
            </if>
            <if test="sortOrder != null">
                sort_order,
            </if>
            <if test="level != null">
                level,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">
                #{parentId},
            </if>
            <if test="name != null and name != ''">
                #{name},
            </if>
            <if test="sortOrder != null">
                #{sortOrder},
            </if>
            <if test="level != null">
                #{level},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.ItemCategory">
        UPDATE item_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">
                parent_id = #{parentId},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="sortOrder != null">
                sort_order = #{sortOrder},
            </if>
            <if test="level != null">
                level = #{level},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM item_category
        WHERE id = #{id}
    </delete>
</mapper>
