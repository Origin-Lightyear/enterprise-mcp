            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="createdAt != null">
                #{createdAt},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.OrgStore">
        UPDATE org_store
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">
