<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.SysUserMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="SysUserResultMap" type="com.kevin.mcp.entity.SysUser">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="username" property="username"/>
        <result column="real_name" property="realName"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="mobile" property="mobile"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        store_id,
        username,
        real_name,
        password,
        role,
        mobile,
        status,
        created_at
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="SysUserResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="SysUserResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="username != null and username != ''">
                AND username = #{username}
            </if>
            <if test="realName != null and realName != ''">
                AND real_name = #{realName}
            </if>
            <if test="password != null and password != ''">
                AND password = #{password}
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="mobile != null and mobile != ''">
                AND mobile = #{mobile}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM sys_user
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="username != null and username != ''">
                AND username = #{username}
            </if>
            <if test="realName != null and realName != ''">
                AND real_name = #{realName}
            </if>
            <if test="password != null and password != ''">
                AND password = #{password}
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="mobile != null and mobile != ''">
                AND mobile = #{mobile}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.SysUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">
                store_id,
            </if>
            <if test="username != null and username != ''">
                username,
            </if>
            <if test="realName != null and realName != ''">
                real_name,
            </if>
            <if test="password != null and password != ''">
                password,
            </if>
            <if test="role != null and role != ''">
                role,
            </if>
            <if test="mobile != null and mobile != ''">
                mobile,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="createdAt != null">
                created_at,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">
                #{storeId},
            </if>
            <if test="username != null and username != ''">
                #{username},
            </if>
            <if test="realName != null and realName != ''">
                #{realName},
            </if>
            <if test="password != null and password != ''">
                #{password},
            </if>
            <if test="role != null and role != ''">
                #{role},
            </if>
            <if test="mobile != null and mobile != ''">
                #{mobile},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="createdAt != null">
                #{createdAt},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.SysUser">
        UPDATE sys_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="storeId != null">
                store_id = #{storeId},
            </if>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="realName != null and realName != ''">
                real_name = #{realName},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="role != null and role != ''">
                role = #{role},
            </if>
            <if test="mobile != null and mobile != ''">
                mobile = #{mobile},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="createdAt != null">
                created_at = #{createdAt},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM sys_user
        WHERE id = #{id}
    </delete>
</mapper>
