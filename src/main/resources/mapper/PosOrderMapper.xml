<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.PosOrderMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="PosOrderResultMap" type="com.kevin.mcp.entity.PosOrder">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="store_id" property="storeId"/>
        <result column="shift_id" property="shiftId"/>
        <result column="cashier_id" property="cashierId"/>
        <result column="member_id" property="memberId"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="order_time" property="orderTime"/>
        <result column="status" property="status"/>
        <result column="return_parent_no" property="returnParentNo"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        order_no,
        store_id,
        shift_id,
        cashier_id,
        member_id,
        total_amount,
        discount_amount,
        pay_amount,
        order_time,
        status,
        return_parent_no
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="PosOrderResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pos_order
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="PosOrderResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pos_order
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no = #{orderNo}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="shiftId != null">
                AND shift_id = #{shiftId}
            </if>
            <if test="cashierId != null">
                AND cashier_id = #{cashierId}
            </if>
            <if test="memberId != null">
                AND member_id = #{memberId}
            </if>
            <if test="totalAmount != null">
                AND total_amount = #{totalAmount}
            </if>
            <if test="discountAmount != null">
                AND discount_amount = #{discountAmount}
            </if>
            <if test="payAmount != null">
                AND pay_amount = #{payAmount}
            </if>
            <if test="orderTime != null">
                AND order_time = #{orderTime}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="returnParentNo != null and returnParentNo != ''">
                AND return_parent_no = #{returnParentNo}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM pos_order
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no = #{orderNo}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="shiftId != null">
                AND shift_id = #{shiftId}
            </if>
            <if test="cashierId != null">
                AND cashier_id = #{cashierId}
            </if>
            <if test="memberId != null">
                AND member_id = #{memberId}
            </if>
            <if test="totalAmount != null">
                AND total_amount = #{totalAmount}
            </if>
            <if test="discountAmount != null">
                AND discount_amount = #{discountAmount}
            </if>
            <if test="payAmount != null">
                AND pay_amount = #{payAmount}
            </if>
            <if test="orderTime != null">
                AND order_time = #{orderTime}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="returnParentNo != null and returnParentNo != ''">
                AND return_parent_no = #{returnParentNo}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.PosOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pos_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">
                order_no,
            </if>
            <if test="storeId != null">
                store_id,
            </if>
            <if test="shiftId != null">
                shift_id,
            </if>
            <if test="cashierId != null">
                cashier_id,
            </if>
            <if test="memberId != null">
                member_id,
            </if>
            <if test="totalAmount != null">
                total_amount,
            </if>
            <if test="discountAmount != null">
                discount_amount,
            </if>
            <if test="payAmount != null">
                pay_amount,
            </if>
            <if test="orderTime != null">
                order_time,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="returnParentNo != null and returnParentNo != ''">
                return_parent_no,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">
                #{orderNo},
            </if>
            <if test="storeId != null">
                #{storeId},
            </if>
            <if test="shiftId != null">
                #{shiftId},
            </if>
            <if test="cashierId != null">
                #{cashierId},
            </if>
            <if test="memberId != null">
                #{memberId},
            </if>
            <if test="totalAmount != null">
