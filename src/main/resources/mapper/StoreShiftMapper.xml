<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.StoreShiftMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="StoreShiftResultMap" type="com.kevin.mcp.entity.StoreShift">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="cashier_id" property="cashierId"/>
        <result column="shift_no" property="shiftNo"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="expected_amount" property="expectedAmount"/>
        <result column="actual_amount" property="actualAmount"/>
        <result column="difference" property="difference"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        store_id,
        cashier_id,
        shift_no,
        start_time,
        end_time,
        expected_amount,
        actual_amount,
        difference,
        status
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="StoreShiftResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM store_shift
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="StoreShiftResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM store_shift
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="cashierId != null">
                AND cashier_id = #{cashierId}
            </if>
            <if test="shiftNo != null and shiftNo != ''">
                AND shift_no = #{shiftNo}
            </if>
            <if test="startTime != null">
                AND start_time = #{startTime}
            </if>
            <if test="endTime != null">
                AND end_time = #{endTime}
            </if>
            <if test="expectedAmount != null">
                AND expected_amount = #{expectedAmount}
            </if>
            <if test="actualAmount != null">
                AND actual_amount = #{actualAmount}
            </if>
            <if test="difference != null">
                AND difference = #{difference}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM store_shift
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="cashierId != null">
                AND cashier_id = #{cashierId}
            </if>
            <if test="shiftNo != null and shiftNo != ''">
                AND shift_no = #{shiftNo}
            </if>
            <if test="startTime != null">
                AND start_time = #{startTime}
            </if>
            <if test="endTime != null">
                AND end_time = #{endTime}
            </if>
            <if test="expectedAmount != null">
                AND expected_amount = #{expectedAmount}
            </if>
            <if test="actualAmount != null">
                AND actual_amount = #{actualAmount}
            </if>
            <if test="difference != null">
                AND difference = #{difference}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.StoreShift" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO store_shift
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">
                store_id,
            </if>
            <if test="cashierId != null">
                cashier_id,
            </if>
            <if test="shiftNo != null and shiftNo != ''">
                shift_no,
            </if>
            <if test="startTime != null">
                start_time,
            </if>
            <if test="endTime != null">
                end_time,
            </if>
            <if test="expectedAmount != null">
                expected_amount,
            </if>
            <if test="actualAmount != null">
                actual_amount,
            </if>
            <if test="status != null">
                status,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">
                #{storeId},
            </if>
            <if test="cashierId != null">
                #{cashierId},
            </if>
            <if test="shiftNo != null and shiftNo != ''">
                #{shiftNo},
            </if>
            <if test="startTime != null">
                #{startTime},
            </if>
            <if test="endTime != null">
                #{endTime},
            </if>
            <if test="expectedAmount != null">
                #{expectedAmount},
            </if>
            <if test="actualAmount != null">
                #{actualAmount},
            </if>
            <if test="status != null">
                #{status},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.StoreShift">
        UPDATE store_shift
        <trim prefix="SET" suffixOverrides=",">
            <if test="storeId != null">
                store_id = #{storeId},
            </if>
            <if test="cashierId != null">
                cashier_id = #{cashierId},
            </if>
            <if test="shiftNo != null and shiftNo != ''">
                shift_no = #{shiftNo},
            </if>
            <if test="startTime != null">
                start_time = #{startTime},
            </if>
            <if test="endTime != null">
                end_time = #{endTime},
            </if>
            <if test="expectedAmount != null">
                expected_amount = #{expectedAmount},
            </if>
            <if test="actualAmount != null">
                actual_amount = #{actualAmount},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM store_shift
        WHERE id = #{id}
    </delete>
</mapper>
