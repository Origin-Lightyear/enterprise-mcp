<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.PurchaseOrderDetailMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="PurchaseOrderDetailResultMap" type="com.kevin.mcp.entity.PurchaseOrderDetail">
        <id column="id" property="id"/>
        <result column="po_id" property="poId"/>
        <result column="sku_id" property="skuId"/>
        <result column="qty" property="qty"/>
        <result column="price" property="price"/>
        <result column="amount" property="amount"/>
        <result column="received_qty" property="receivedQty"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        po_id,
        sku_id,
        qty,
        price,
        amount,
        received_qty,
        remark
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="PurchaseOrderDetailResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM purchase_order_detail
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="PurchaseOrderDetailResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM purchase_order_detail
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="poId != null">
                AND po_id = #{poId}
            </if>
            <if test="skuId != null">
                AND sku_id = #{skuId}
            </if>
            <if test="qty != null">
                AND qty = #{qty}
            </if>
            <if test="price != null">
                AND price = #{price}
            </if>
            <if test="amount != null">
                AND amount = #{amount}
            </if>
            <if test="receivedQty != null">
                AND received_qty = #{receivedQty}
            </if>
            <if test="remark != null and remark != ''">
                AND remark = #{remark}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM purchase_order_detail
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="poId != null">
                AND po_id = #{poId}
            </if>
            <if test="skuId != null">
                AND sku_id = #{skuId}
            </if>
            <if test="qty != null">
                AND qty = #{qty}
            </if>
            <if test="price != null">
                AND price = #{price}
            </if>
            <if test="amount != null">
                AND amount = #{amount}
            </if>
            <if test="receivedQty != null">
                AND received_qty = #{receivedQty}
            </if>
            <if test="remark != null and remark != ''">
                AND remark = #{remark}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.PurchaseOrderDetail" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO purchase_order_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="poId != null">
                po_id,
            </if>
            <if test="skuId != null">
                sku_id,
            </if>
            <if test="qty != null">
                qty,
            </if>
            <if test="price != null">
                price,
            </if>
            <if test="amount != null">
                amount,
            </if>
            <if test="receivedQty != null">
                received_qty,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="poId != null">
                #{poId},
            </if>
            <if test="skuId != null">
                #{skuId},
            </if>
            <if test="qty != null">
                #{qty},
            </if>
            <if test="price != null">
                #{price},
            </if>
            <if test="amount != null">
                #{amount},
            </if>
            <if test="receivedQty != null">
                #{receivedQty},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.PurchaseOrderDetail">
        UPDATE purchase_order_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="poId != null">
                po_id = #{poId},
            </if>
            <if test="skuId != null">
                sku_id = #{skuId},
            </if>
            <if test="qty != null">
                qty = #{qty},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="amount != null">
                amount = #{amount},
            </if>
            <if test="receivedQty != null">
                received_qty = #{receivedQty},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM purchase_order_detail
        WHERE id = #{id}
    </delete>
</mapper>
