    <insert id="insert" parameterType="com.kevin.mcp.entity.PromotionScopeItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO promotion_scope_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
