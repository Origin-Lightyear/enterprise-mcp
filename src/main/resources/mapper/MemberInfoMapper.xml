<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kevin.mcp.mapper.MemberInfoMapper">

    <!-- 映射数据库字段与实体属性 -->
    <resultMap id="MemberInfoResultMap" type="com.kevin.mcp.entity.MemberInfo">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="level_id" property="levelId"/>
        <result column="total_points" property="totalPoints"/>
        <result column="available_points" property="availablePoints"/>
        <result column="register_store_id" property="registerStoreId"/>
        <result column="birthday" property="birthday"/>
        <result column="gender" property="gender"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 复用基础查询列 -->
    <sql id="Base_Column_List">
        id,
        code,
        name,
        phone,
        level_id,
        total_points,
        available_points,
        register_store_id,
        birthday,
        gender,
        created_at
    </sql>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="MemberInfoResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member_info
        WHERE id = #{id}
    </select>

    <!-- 按非空条件查询记录列表 -->
    <select id="selectByCondition" resultMap="MemberInfoResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member_info
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="code != null and code != ''">
                AND code = #{code}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="levelId != null">
                AND level_id = #{levelId}
            </if>
            <if test="totalPoints != null">
                AND total_points = #{totalPoints}
            </if>
            <if test="availablePoints != null">
                AND available_points = #{availablePoints}
            </if>
            <if test="registerStoreId != null">
                AND register_store_id = #{registerStoreId}
            </if>
            <if test="birthday != null">
                AND birthday = #{birthday}
            </if>
            <if test="gender != null">
                AND gender = #{gender}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 按非空条件统计记录数量 -->
    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM member_info
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="code != null and code != ''">
                AND code = #{code}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="levelId != null">
                AND level_id = #{levelId}
            </if>
            <if test="totalPoints != null">
                AND total_points = #{totalPoints}
            </if>
            <if test="availablePoints != null">
                AND available_points = #{availablePoints}
            </if>
            <if test="registerStoreId != null">
                AND register_store_id = #{registerStoreId}
            </if>
            <if test="birthday != null">
                AND birthday = #{birthday}
            </if>
            <if test="gender != null">
                AND gender = #{gender}
            </if>
            <if test="createdAt != null">
                AND created_at = #{createdAt}
            </if>
        </where>
    </select>

    <!-- 动态新增非空字段，主键回填到实体 -->
    <insert id="insert" parameterType="com.kevin.mcp.entity.MemberInfo" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">
                code,
            </if>
            <if test="name != null and name != ''">
                name,
            </if>
            <if test="phone != null and phone != ''">
                phone,
            </if>
            <if test="levelId != null">
                level_id,
            </if>
            <if test="totalPoints != null">
                total_points,
            </if>
            <if test="availablePoints != null">
                available_points,
            </if>
            <if test="registerStoreId != null">
                register_store_id,
            </if>
            <if test="birthday != null">
                birthday,
            </if>
            <if test="gender != null">
                gender,
            </if>
            <if test="createdAt != null">
                created_at,
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">
                #{code},
            </if>
            <if test="name != null and name != ''">
                #{name},
            </if>
            <if test="phone != null and phone != ''">
                #{phone},
            </if>
            <if test="levelId != null">
                #{levelId},
            </if>
            <if test="totalPoints != null">
                #{totalPoints},
            </if>
            <if test="availablePoints != null">
                #{availablePoints},
            </if>
            <if test="registerStoreId != null">
                #{registerStoreId},
            </if>
            <if test="birthday != null">
                #{birthday},
            </if>
            <if test="gender != null">
                #{gender},
            </if>
            <if test="createdAt != null">
                #{createdAt},
            </if>
        </trim>
    </insert>

    <!-- 根据主键动态更新非空字段 -->
    <update id="updateById" parameterType="com.kevin.mcp.entity.MemberInfo">
        UPDATE member_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">
                code = #{code},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="levelId != null">
                level_id = #{levelId},
            </if>
            <if test="totalPoints != null">
                total_points = #{totalPoints},
            </if>
            <if test="availablePoints != null">
                available_points = #{availablePoints},
            </if>
            <if test="registerStoreId != null">
                register_store_id = #{registerStoreId},
            </if>
            <if test="birthday != null">
                birthday = #{birthday},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="createdAt != null">
                created_at = #{createdAt},
            </if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除单条记录 -->
    <delete id="deleteById">
        DELETE FROM member_info
        WHERE id = #{id}
    </delete>
</mapper>
