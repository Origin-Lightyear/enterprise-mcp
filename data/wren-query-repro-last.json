    "sql": "WITH company_ranked AS (SELECT id AS company_pk, code AS company_code, name AS company_name, legal_person AS company_legal_person, tax_number AS company_tax_number, status AS company_status, created_at AS company_created_at, ROW_NUMBER() OVER (ORDER BY id) AS rn FROM OrgCompany), store_ranked AS (SELECT id AS store_pk, company_id AS store_company_id, region_id AS store_region_id, code AS store_code, name AS store_name, level AS store_level, address AS store_address, contact_phone AS store_contact_phone, business_hours AS store_business_hours, status AS store_status, created_at AS store_created_at, ROW_NUMBER() OVER (ORDER BY id) AS rn FROM OrgStore) SELECT 'OrgCompany' AS source_model, c.company_pk AS id, c.company_code AS code, c.company_name AS name, c.company_legal_person AS legal_person, c.company_tax_number AS tax_number, NULL AS company_id, NULL AS region_id, NULL AS level, NULL AS address, NULL AS contact_phone, NULL AS business_hours, c.company_status AS status, c.company_created_at AS created_at FROM company_ranked AS c WHERE c.rn <= 20 UNION ALL SELECT 'OrgStore' AS source_model, s.store_pk AS id, s.store_code AS code, s.store_name AS name, NULL AS legal_person, NULL AS tax_number, s.store_company_id AS company_id, s.store_region_id AS region_id, s.store_level AS level, s.store_address AS address, s.store_contact_phone AS contact_phone, s.store_business_hours AS business_hours, s.store_status AS status, s.store_created_at AS created_at FROM store_ranked AS s WHERE s.rn <= 20 ORDER BY source_model, id"
